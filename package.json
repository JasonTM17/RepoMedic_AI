{
  "name": "repomedic",
  "version": "1.0.0",
  "description": "Local-first AI bug triage and guarded patch assistant",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:fs-guard && npm run build:exec-guard && npm run build:api-client && npm run build:api && npm run build:cli && npm run build:web",
    "build:api": "npm run build --workspace=@jasonTM17/api",
    "build:api-client": "npm run build --workspace=@jasonTM17/api-client",
    "build:cli": "npm run build --workspace=@jasonTM17/cli",
    "build:core": "npm run build --workspace=@jasonTM17/core",
    "build:exec-guard": "npm run build --workspace=@jasonTM17/exec-guard",
    "build:web": "npm run build --workspace=@jasonTM17/web",
    "dev:api": "npm run dev --workspace=@jasonTM17/api",
    "dev:web": "npm run dev --workspace=@jasonTM17/web",
    "generate:api-client": "npm run generate:check --workspace=@jasonTM17/api-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "repomedic": "npm run repomedic --workspace=@jasonTM17/cli --",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration apps/**/tests/integration packages/**/tests/integration",
    "test:security": "vitest run tests/security packages/**/tests/security",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspace=@jasonTM17/core && npm run typecheck --workspace=@jasonTM17/fs-guard && npm run typecheck --workspace=@jasonTM17/exec-guard && npm run typecheck --workspace=@jasonTM17/api-client && npm run typecheck --workspace=@jasonTM17/api && npm run typecheck --workspace=@jasonTM17/cli && npm run typecheck --workspace=@jasonTM17/web",
    "eval": "tsx evals/run-evals.ts",
    "build:fs-guard": "npm run build --workspace=@jasonTM17/fs-guard",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
