{
  "name": "@jasonTM17/fs-guard",
  "version": "0.1.0",
  "description": "Secure filesystem access with realpath confinement and TOCTOU guards for RepoMedic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "license": "MIT",
  "repository": "https://github.com/JasonTM17/RepoMedic_AI"
}
