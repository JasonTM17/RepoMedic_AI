{
  "name": "@repomedic/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-ts -f openapi-ts.config.ts",
    "generate:check": "npm run generate && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.0"
  },
  "repository": "https://github.com/JasonTM17/RepoMedic_AI"
}
