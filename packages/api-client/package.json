{
  "name": "@jasonTM17/api-client",
  "version": "0.1.0",
  "description": "Generated OpenAPI client for the RepoMedic API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-ts -f openapi-ts.config.ts",
    "generate:check": "npm run generate && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "license": "MIT",
  "repository": "https://github.com/JasonTM17/RepoMedic_AI"
}
