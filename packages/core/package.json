{
  "name": "@jasonTM17/core",
  "version": "0.1.0",
  "description": "Deterministic core domain, schemas, and policy for RepoMedic — a local-first AI bug triage and guarded patch assistant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
